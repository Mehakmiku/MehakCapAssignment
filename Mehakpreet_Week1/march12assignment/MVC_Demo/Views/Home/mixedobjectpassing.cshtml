@model MVC_Demo.Models.EmpdeptViewModel
@{
    ViewData["Title"] = "mixedobjectpassing";
}

<h1>mixedobjectpassing</h1>

<h2> Date:@Model.date</h2>
<h3>Dept details</h3>
<table border="1" cellpadding="3" cellspacing="3">
    <tr>
        <th>Deptid</th>
        <th>DeptName</th>
    </tr>
    <tr>
        @foreach(var dept in Model.deptlist)
        {
            <tr>
                <td>@dept.DeptID</td>
                <td>@dept.DeptName</td>
            </tr>
        }
    </tr>
</table>
<h3>search emp</h3>
<h1>@Model.emp</h1>
<div>
    <img src="@Model.emp.ImageUrl" alt="@Model.emp.EmpName" width="300" height="300" />
</div>

<div>
    <h2>Employee details</h2>
    <p>
        Lorem Ipsum simply dummy text of the printing and typesetting
    </p>
    <h2>@Model.emp.salary</h2>
    <h2><a asp-action="collectionofobjectpassing">back to list</a></h2>
</div>
